<!-- Self-contained on purpose (no application resources), so tests can create it without starting the app. -->
<Window x:Class="FileSearch.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About File Search"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,18,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Source="pack://application:,,,/FileSearch;component/Assets/FileSearch.ico"
               Width="64" Height="64" VerticalAlignment="Top" Margin="0,2,18,0"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="File Search icon" />

        <StackPanel Grid.Column="1" MinWidth="330">
            <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Margin="0,2,0,0" Foreground="#555555" />
            <TextBlock x:Name="DescriptionText" Margin="0,10,0,0" />
            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="360" Foreground="#555555" />

            <!-- Links open in the default browser. -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="RepositoryLink" RequestNavigate="Link_RequestNavigate">Source code on GitHub</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="RepositoryUrlText" Margin="0,0,0,4" Foreground="#555555" FontSize="11" />
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="ManualLink" RequestNavigate="Link_RequestNavigate">User manual</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="ReleasesLink" RequestNavigate="Link_RequestNavigate">Check for a newer version</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="IssuesLink" RequestNavigate="Link_RequestNavigate">Report a problem or suggest an idea</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,2">
                    <Hyperlink x:Name="LicenseLink" RequestNavigate="Link_RequestNavigate">
                        <Run x:Name="LicenseRun" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyButton" Content="Copy details" Padding="12,3" Click="Copy_Click"
                    ToolTip="Copy the version and Windows details, for example for a bug report" />
            <Button Content="Close" Padding="18,3" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
