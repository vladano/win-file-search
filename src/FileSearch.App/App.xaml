<Application x:Class="FileSearch.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Content" Value="&#xE711;" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Close search (Ctrl+W)" />
        </Style>

        <Style x:Key="SmallToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2E7D32" />
            <Setter Property="ToolTip" Value="Match case" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Application.Resources>
</Application>
