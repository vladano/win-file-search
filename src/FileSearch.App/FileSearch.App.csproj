<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileSearch</AssemblyName>
    <RootNamespace>FileSearch.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon of the exe: Explorer, taskbar, Start menu and the Explorer context-menu entry ("exe",0).
         Regenerate with tools/icon/make-icon.ps1. -->
    <ApplicationIcon>Assets\FileSearch.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shown in the exe's Properties > Details tab. The release workflow overrides Version from the git tag. -->
  <PropertyGroup>
    <Version>0.1.2</Version>
    <Product>File Search</Product>
    <AssemblyTitle>File Search</AssemblyTitle>
    <Description>Fast file content search for Windows. https://github.com/vladano/win-file-search</Description>
    <Company>vladano</Company>
    <Copyright>Copyright (c) 2026 vladano. MIT License. https://github.com/vladano/win-file-search</Copyright>
  </PropertyGroup>

  <!-- Single-file publish: compress the bundle (roughly halves the size) and keep native WPF libraries inside it. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon as a WPF resource, for the window title bar and Alt+Tab. -->
    <Resource Include="Assets\FileSearch.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="FileSearch.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileSearch.Core\FileSearch.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
