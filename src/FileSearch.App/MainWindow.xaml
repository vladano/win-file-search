<Window x:Class="FileSearch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileSearch.App"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/FileSearch;component/Assets/FileSearch.ico"
        Width="1200" Height="740" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}" CommandParameter="{Binding SelectedTab}" />
        <KeyBinding Key="F5" Command="{Binding SelectedTab.StartCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0" ToolBarTray.IsLocked="True">
                <Button Command="{Binding AddTabCommand}" ToolTip="New search (Ctrl+N)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                </Button>
                <Button Click="OpenDefinition_Click" ToolTip="Open saved search">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Foreground="#F9A825" />
                </Button>
                <Button Click="SaveDefinition_Click" ToolTip="Save search definition">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                </Button>
                <Button Click="Export_Click" ToolTip="Export results (TXT or CSV)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                </Button>
                <Separator />
                <Button Command="{Binding SelectedTab.StartCommand}" ToolTip="Start (F5)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="#2E7D32" />
                </Button>
                <Button Command="{Binding SelectedTab.PauseCommand}" ToolTip="Pause / resume">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" />
                </Button>
                <Button Command="{Binding SelectedTab.StopCommand}" ToolTip="Stop">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Foreground="#C62828" />
                </Button>
                <Separator />
                <Menu Background="Transparent">
                    <MenuItem ToolTip="Tools">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,4,0" />
                                <TextBlock Text="Tools" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem Header="Add to Explorer context menu" Click="InstallShell_Click" />
                        <MenuItem Header="Remove from Explorer context menu" Click="UninstallShell_Click" />
                        <Separator />
                        <MenuItem Header="Search syntax help" Click="Help_Click" />
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedTab.StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectedTab.Results.Count, StringFormat={}{0:N0} results}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" BorderThickness="0,1,0,0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE721;" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TabCloseButton}"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:SearchTabView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
